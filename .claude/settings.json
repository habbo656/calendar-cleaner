{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm ci)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm view *)",
      "Bash(npm outdated*)",
      "Bash(npx vitest *)",
      "Bash(npx playwright *)",
      "Bash(npx prettier *)",
      "Bash(npx eslint *)",
      "Bash(npx tsc *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git switch*)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git rebase origin/main)",
      "Bash(git push -u origin *)",
      "Bash(git push origin *)",
      "Bash(git stash*)",
      "Bash(gh pr *)",
      "Bash(gh issue *)",
      "Bash(gh run *)",
      "Bash(gh label *)",
      "Bash(gh repo view*)",
      "Edit(src/**)",
      "Edit(e2e/**)",
      "Edit(docs/**)",
      "Write(src/**)",
      "Write(e2e/**)",
      "Write(docs/**)"
    ],
    "deny": [
      "Bash(git push origin main*)",
      "Bash(git push * main)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(gh pr merge * --admin*)",
      "Bash(gh repo delete*)",
      "Bash(gh secret *)",
      "Read(.env)",
      "Read(.env.*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/format-hook.mjs\"" }
        ]
      }
    ]
  }
}
